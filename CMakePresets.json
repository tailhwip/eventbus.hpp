{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-win32",
      "binaryDir": "${sourceDir}/build/clang",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_FRONTEND_VARIANT": "MSVC",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER_FRONTEND_VARIANT": "MSVC"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-linux",
      "binaryDir": "${sourceDir}/build/clang",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-win32",
      "configurePreset": "clang-win32"
    },
    {
      "name": "clang-linux",
      "configurePreset": "clang-linux"
    }
  ]
}
